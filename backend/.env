# Copia este archivo a .env y rellena tus valores reales.
# .env NUNCA se sube a git (mira .gitignore) — ahí van tus credenciales reales.

# --- Opción A: Gmail ---
# 1. Activa la verificación en dos pasos en tu cuenta de Google.
# 2. Crea una "contraseña de aplicación" en:
#    https://myaccount.google.com/apppasswords
#    (NO uses tu contraseña normal de Gmail, esa no funciona con SMTP)
# 3. Usa esa contraseña de 16 caracteres como SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion

# --- Opción B: Proton Mail ---
# Necesitas tener Proton Mail Bridge corriendo en tu ordenador (es una app
# aparte que Proton ofrece gratis). Bridge te da un host/puerto/usuario/
# contraseña LOCALES distintos a tu contraseña de Proton normal — cópialos
# de la ventana de Bridge, algo así:
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_USER=tu-cuenta@proton.me
# SMTP_PASS=la-contrasena-que-te-da-bridge

# Dirección a la que llegan los mensajes del formulario de contacto.
# Si la omites, se usa SMTP_USER.
CONTACT_TO=joandomz91@proton.me
